---
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = [
	{
		authors: 'Z. Zhao, E. Tajkhorshid.',
		title: 'Cytosolic K⁺ binding to the human serotonin transporter.',
		venue: 'Journal of Chemical Theory and Computation',
		year: '2026',
		doi: 'https://doi.org/10.1021/acs.jctc.6c00511',
	},
	{
		authors: 'Z. Zhao, P.-C. Wen, E. Tajkhorshid.',
		title:
			'An orchestrated interaction network at the binding site of human SERT enables serotonin occlusion and import.',
		venue: 'Biochemistry',
		year: '2025',
		doi: 'https://doi.org/10.1021/acs.biochem.5c00240',
	},
	{
		authors: 'Z. Zhao, E. Tajkhorshid.',
		title:
			'GOLEM: automated and robust cryo-EM–guided ligand docking with explicit water molecules.',
		venue: 'Journal of Chemical Information and Modeling',
		year: '2024',
		doi: 'https://doi.org/10.1021/acs.jcim.4c00917',
	},
	{
		authors: 'D. Yang, Z. Zhao, E. Tajkhorshid, E. Gouaux.',
		title:
			'Structures and membrane interactions of native serotonin transporter in complexes with psychostimulants.',
		venue: 'PNAS',
		year: '2023',
		doi: 'https://doi.org/10.1073/pnas.2304602120',
	},
	{
		authors: 'J. Ge, J. Elferich, S. Dehghani-Ghahnaviyeh, Z. Zhao, et al.',
		title: 'Molecular mechanism of prestin electromotive signal amplification.',
		venue: 'Cell',
		year: '2021',
		doi: 'https://doi.org/10.1016/j.cell.2021.07.034',
	},
	{
		authors: 'P. Kumar, Y. Wang, Z. Zhang, Z. Zhao, et al.',
		title:
			'Cryo-EM structures of a lipid-sensitive pentameric ligand-gated ion channel embedded in a phosphatidylcholine-only bilayer.',
		venue: 'PNAS',
		year: '2020',
		doi: 'https://doi.org/10.1073/pnas.1906823117',
	},
	{
		authors: 'J. A. Coleman, D. Yang, Z. Zhao, P.-C. Wen, et al.',
		title:
			'Serotonin transporter–ibogaine complexes illuminate mechanisms of inhibition and transport.',
		venue: 'Nature',
		year: '2019',
		doi: 'https://doi.org/10.1038/s41586-019-1135-1',
	},
];

const interests = [
	'Machine learning for structure-based drug discovery',
	'Diffusion models & geometric deep learning for molecular docking',
	'LLM agents and language-model post-training (SFT, RLVR)',
	'Molecular dynamics & enhanced-sampling free-energy methods',
	'Structure and mechanism of membrane transporters & ion channels',
];
---

<BaseLayout>
	<header class="intro">
		<img class="avatar" src="/assets/portrait.jpg" alt="Zhiyu Zhao" width="200" height="250" />
		<div class="identity">
			<h1>Zhiyu (Joe) Zhao</h1>
			<p class="role">Machine Learning Engineer, Apple</p>
			<p class="sub">Ph.D., Computational Biophysics</p>
			<p class="contact">
				<a href="mailto:zhiyuzhao0423@gmail.com">Email</a>
				<span>·</span>
				<a href="https://scholar.google.com/citations?user=xEd8eLsAAAAJ&hl=en">Google Scholar</a>
				<span>·</span>
				<a href="https://github.com/zyzhao1993">GitHub</a>
				<span>·</span>
				<a href="https://www.linkedin.com/in/zhiyu-z-b051ba13a/">LinkedIn</a>
			</p>
		</div>
	</header>

	<section id="about" class="prose">
		<p>
			I'm a Machine Learning Engineer at <strong>Apple</strong>, where I build production LLM
			agents and post-train language models. I came to machine-learning engineering from
			computational science: previously I was a postdoctoral researcher in the Department of
			Computer Science at <strong>Stanford University</strong>; I earned my <strong>Ph.D. in
			Biophysics</strong> from the University of Illinois Urbana-Champaign; and I completed my
			<strong>B.S. in Physics</strong> — with a minor in Computer Science — at Shanghai Jiao Tong
			University.
		</p>
		<p>
			My work bridges machine learning and the molecular sciences. I develop deep-learning methods
			for molecular structure and interaction prediction — including diffusion models and geometric
			deep learning for ligand docking — and I bring a decade of experience in physics-based
			simulation: molecular dynamics, enhanced-sampling free-energy calculations, and cryo-EM–guided
			modeling of proteins, membrane transporters, and ion channels. I'm increasingly focused on
			agentic LLM systems and how these tools can accelerate scientific discovery.
		</p>
	</section>

	<section class="block">
		<h2>Research Interests</h2>
		<ul class="interests">
			{interests.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section id="publications" class="block">
		<h2>Selected Publications</h2>
		<ol class="pubs">
			{
				publications.map((p) => (
					<li>
						<span class="authors" set:html={p.authors.replace('Z. Zhao', '<b>Z. Zhao</b>')} />{' '}
						{p.title} <i>{p.venue}</i>, {p.year}. <a href={p.doi}>[link]</a>
					</li>
				))
			}
		</ol>
		<p class="more">
			See my <a href="https://scholar.google.com/citations?user=xEd8eLsAAAAJ&hl=en">Google Scholar</a>
			profile for the full list of publications.
		</p>
	</section>
</BaseLayout>

<style>
	.intro {
		display: flex;
		gap: 2rem;
		align-items: center;
		margin-bottom: 2.5rem;
	}

	.avatar {
		width: 160px;
		height: 200px;
		object-fit: cover;
		border-radius: 8px;
		flex: none;
	}

	.identity h1 {
		font-size: 2.1rem;
		font-weight: 600;
		color: #14171d;
		letter-spacing: -0.01em;
	}

	.role {
		margin-top: 0.5rem;
		font-size: 1.1rem;
		font-weight: 500;
		color: #262a31;
	}

	.sub {
		color: #5a606b;
		font-size: 1rem;
	}

	.contact {
		margin-top: 0.75rem;
		font-size: 0.95rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0.6rem;
		align-items: center;
	}

	.contact span {
		color: #c3c7cf;
	}

	.prose p {
		margin-bottom: 1.1rem;
		font-size: 1.05rem;
		line-height: 1.7;
		color: #2b2f37;
	}

	.prose strong {
		font-weight: 600;
		color: #14171d;
	}

	.block {
		margin-top: 2.5rem;
	}

	.block h2 {
		font-size: 1.35rem;
		font-weight: 600;
		color: #14171d;
		padding-bottom: 0.5rem;
		margin-bottom: 1rem;
		border-bottom: 1px solid #e7e8ec;
	}

	.interests {
		padding-left: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.interests li {
		font-size: 1.03rem;
		line-height: 1.5;
		color: #2b2f37;
	}

	.pubs {
		padding-left: 1.4rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.pubs li {
		font-size: 1rem;
		line-height: 1.6;
		color: #2b2f37;
	}

	.pubs .authors b {
		color: #14171d;
	}

	.more {
		margin-top: 1.5rem;
		font-size: 0.98rem;
		color: #5a606b;
	}

	@media (max-width: 34em) {
		.intro {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}
	}
</style>
