---
const links = [
	{ label: 'About', href: '/#about' },
	{ label: 'Experience', href: '/#experience' },
	{ label: 'Publications', href: '/#publications' },
	{
		label: 'Google Scholar',
		href: 'https://scholar.google.com/citations?user=xEd8eLsAAAAJ&hl=en',
	},
];
---

<nav>
	<div class="inner">
		<a class="brand" href="/">Zhiyu Zhao</a>
		<div class="links">
			{
				links.map(({ label, href }) => (
					<a href={href}>{label}</a>
				))
			}
		</div>
	</div>
</nav>

<style>
	nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.85);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid #e7e8ec;
	}

	.inner {
		max-width: 46rem;
		margin-inline: auto;
		padding: 0.85rem 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.brand {
		font-family: var(--font-brand);
		font-size: 1.15rem;
		font-weight: 600;
		color: #1a1d24;
		text-decoration: none;
	}

	.links {
		display: flex;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.links a {
		color: #4a4f5a;
		text-decoration: none;
		font-size: 0.95rem;
	}

	.links a:hover,
	.links a:focus {
		color: #1a51a8;
	}
</style>
